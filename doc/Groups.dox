/**
 * @defgroup raze_algo Algorithms
 * Range-based algorithms.
 *
 * Vectorized and scalar algorithms like `for_each`, `transform`,
 * and `replace`. Each is an `options::function_with_traits` (or `options::functor`)
 * and accepts compile-time modifiers through `operator[]`.
 *
 * @see @ref dynamic_dispatch
 * @see @ref vectorization_semantics
 * @see @ref mask_semantics
 */

/**
 * @defgroup raze_algo_dispatch Algorithm Dispatch & Vectorization Strategies
 * @ingroup raze_algo
 * @brief Internal and customization primitives controlling compiler strategies,
 *        data sources/destinations, and runtime ISA dynamic dispatch.
 *
 * Includes `strategy`, `strategy_mode`, `targets`, `dispatchable`, `tail_mask`,
 * `source`/`destination` concepts, and `autovectorizable_tag` / `for_noalias` helpers.
 */

/**
 * @defgroup raze_algo_concepts Algorithm Vectorizability Concepts
 * @ingroup raze_algo_dispatch
 * @brief Compile-time concepts probing whether element types, predicates, functions,
 *        and projections can be executed on `raze::vx::simd` types.
 */

/**
 * @defgroup raze_options Options
 * Compile-time modifiers for algorithms and primitives.
 *
 * Passed to algorithm objects via `operator[]` to control vectorization
 * strategy, loop unrolling, and dispatch behavior.
 */

/**
 * @page raze_vx_options SIMD Options (`raze::vx`)
 *
 * Functors in `raze::vx` accept compile-time option flags via `operator[]` (often combinable
 * with @ref mask_semantics):
 *
 * | Option | Applies to | Semantics |
 * |--------|------------|-----------|
 * | `raze::vx::aligned` | `load`, `store`, `compress_store` | Uses aligned load/store instructions (`alignof(V)` required). |
 * | `raze::vx::safe` | `load`, `store` | Guarantees masked-out memory lanes are never read or written. |
 * | `raze::vx::unsafe` | `compress_store` | Allows overwriting trailing lanes up to `V::size()` for speed. |
 * | `raze::vx::not_null` | `find_first_set`, `find_first_not_set`, `find_last_set`, `find_last_not_set`, `find_next_set`, `clear_first`, `clear_last` | Assumes at least one matching lane exists, skipping empty-mask checks (UB if violated). |
 * | `raze::vx::uniform` | `fold` | Returns a SIMD vector with the reduced value broadcast to all lanes. |
 * | `raze::vx::saturated` | `convert` | Performs clamping (saturating) conversion instead of truncation. |
 * | `raze::vx::ignore_unsupported` | `convert` | Returns input unchanged when `T` is not an arithmetic type. |
 */

