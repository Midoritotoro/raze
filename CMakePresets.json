{
  "version": 4,
  "buildPresets": [
    {
      "name": "bench-msvc",
      "configurePreset": "bench-msvc"
    },
    {
      "name": "bench-clang",
      "configurePreset": "bench-clang"
    },
    {
      "name": "bench-gcc",
      "configurePreset": "bench-gcc"
    },
    {
      "name": "bench-icpx",
      "configurePreset": "bench-icpx"
    }
  ],
  "configurePresets": [
    {
      "name": "bench-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "bench-msvc",
      "inherits": "bench-base",
      "binaryDir": "${sourceDir}/out/bench/msvc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "bench-clang",
      "inherits": "bench-base",
      "binaryDir": "${sourceDir}/out/bench/clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "bench-gcc",
      "inherits": "bench-base",
      "binaryDir": "${sourceDir}/out/bench/gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "bench-icpx",
      "inherits": "bench-base",
      "binaryDir": "${sourceDir}/out/bench/icpx",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx",
        "CMAKE_CXX_COMPILER": "icx"
      }
    }
  ]
}