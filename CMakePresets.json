{
  "version": 4,
  "configurePresets": [
    {
      "name": "win-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ]
        }
      }
    },
    {
      "name": "win-msvc-env",
      "hidden": true,
      "inherits": "win-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "x64-msvc-base",
      "hidden": true,
      "inherits": "win-msvc-env",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-msvc-x64",
          "enableMicrosoftCodeAnalysis": true,
          "enableClangTidyCodeAnalysis": true,
          "clangTidyChecks": "*"
        }
      }
    },
    {
      "name": "x64-Debug",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAZE_INSTALL": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "x64-Release",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-clang-cl-base",
      "hidden": true,
      "inherits": "win-msvc-env",
      "toolset": {
        "value": "ClangCL",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-clangcl-x64"
        }
      }
    },
    {
      "name": "x64-Debug-clang",
      "inherits": "x64-clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Release-clang",
      "inherits": "x64-clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-gcc-base",
      "hidden": true,
      "inherits": "win-base",
      "environment": {
        "PATH": "D:/Libraries/win64/msys64/ucrt64/bin;$env{SystemRoot}/system32;$env{SystemRoot}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc.exe",
        "CMAKE_CXX_COMPILER": "g++.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    },
    {
      "name": "GCC-Debug",
      "inherits": "x64-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "GCC-Release",
      "inherits": "x64-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-clang-base",
      "hidden": true,
      "inherits": "win-base",
      "environment": {
        "PATH": "D:/Libraries/win64/msys64/clang64/bin;$env{SystemRoot}/system32;$env{SystemRoot}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang.exe",
        "CMAKE_CXX_COMPILER": "clang++.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    },
    {
      "name": "Clang-Debug",
      "inherits": "x64-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Clang-Release",
      "inherits": "x64-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-icpx-base",
      "hidden": true,
      "inherits": "win-msvc-env",
      "environment": {
        "PATH": "D:/icpx/compiler/2026.2/bin;$penv{PATH}",
        "INCLUDE": "D:/icpx/compiler/2026.2/include;D:/icpx/compiler/2026.2/opt/compiler/include;$penv{INCLUDE}",
        "LIB": "D:/icpx/compiler/2026.2/lib;D:/icpx/compiler/2026.2/lib/intel64;$penv{LIB}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "D:/icpx/compiler/2026.2/bin/icx.exe",
        "CMAKE_CXX_COMPILER": "D:/icpx/compiler/2026.2/bin/icx.exe",
        "CMAKE_EXE_LINKER_FLAGS": "-Xlinker /LIBPATH:\"D:/icpx/compiler/2026.2/lib\" -Xlinker /LIBPATH:\"D:/icpx/compiler/2026.2/lib/intel64\"",
        "CMAKE_SHARED_LINKER_FLAGS": "-Xlinker /LIBPATH:\"D:/icpx/compiler/2026.2/lib\" -Xlinker /LIBPATH:\"D:/icpx/compiler/2026.2/lib/intel64\""
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-clangcl-x64"
        }
      }
    },
    {
      "name": "ICPX-Debug",
      "inherits": "x64-icpx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ICPX-Release",
      "inherits": "x64-icpx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "bench-msvc",
